// OpenRecruitOS Community Edition — Prisma Schema
// Entities: User, Job, Candidate, Application, ApplicationHistory, Interview

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("recruiter") // admin | recruiter
  phone     String?  // as typed (cleaned)
  phoneKey  String?  @unique // canonical phone digits: guarantees one account per phone number
  title     String   @default("") // job title / assigned task shown in the users list
  permissions String @default("") // JSON {area: "none"|"view"|"edit"}; empty = defaults of the role
  active    Boolean  @default(true)
  lastLoginAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Job {
  id             String   @id @default(cuid())
  title          String
  description    String
  skills         String   @default("") // comma-separated
  experience     String   @default("") // e.g. "2-4 years"
  location       String   @default("")
  salary         String   @default("")
  employmentType String   @default("Full-time") // Full-time | Part-time | Contract | Internship
  status         String   @default("Open") // Open | Closed
  categoryId     String?  // optional job classification (any level of the category tree)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  applications   Application[]
  category       JobCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([categoryId])
  @@index([createdAt])
}

// Job classification: a self-referencing tree of any depth (ISCO-08 levels
// plus your own deeper sub-levels).
model JobCategory {
  id        String   @id @default(cuid())
  code      String   @default("") // official code, e.g. "2512" (optional)
  name      String
  nameCkb   String   @default("") // Kurdish Sorani name (optional)
  level     Int      @default(1)  // 1 = top level
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  parent    JobCategory?  @relation("JobCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  JobCategory[] @relation("JobCategoryTree")
  jobs      Job[]
  titles    JobTitle[]

  @@index([parentId])
}

// Static list of job titles. Jobs are created by picking a title from this list
// (new titles can be added on the spot); a title can carry a default classification.
model JobTitle {
  id         String   @id @default(cuid())
  title      String   @unique
  titleCkb   String   @default("")
  categoryId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  category   JobCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
}

model Candidate {
  id           String   @id @default(cuid())
  name         String
  email        String   @default("")
  phone        String   @default("")
  resume       String   @default("") // storage key of uploaded file (local storage key)
  resumeName   String   @default("") // original file name for display/download
  photo        String   @default("") // storage key of the personal photo (shown on the CV)
  skills       String   @default("") // comma-separated
  experience   String   @default("") // e.g. "3 years" / free text
  education    String   @default("")
  location     String   @default("")
  salary       String   @default("")
  noticePeriod String   @default("")
  notes        String   @default("")
  tags         String   @default("") // comma-separated
  customData   String   @default("{}") // JSON map: custom field id -> value
  code         String?  @unique // candidate access code (set when the candidate applies through the portal)
  hasAccess    Boolean  @default(false) // has a candidate login (kept in step with CandidateAccount; lets the list filter fast)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  applications Application[]

  @@index([createdAt])
  @@index([name])
  @@index([phone])
  @@index([hasAccess])
}

model Application {
  id          String   @id @default(cuid())
  candidateId String
  jobId       String
  stage       String   @default("Applied") // Applied | Screening | Interview | Selected | Hired | Rejected
  status      String   @default("Active") // Active | Rejected | Hired
  appliedAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  history     ApplicationHistory[]
  interviews  Interview[]

  @@unique([candidateId, jobId])
  @@index([jobId, stage])
  @@index([stage])
  @@index([appliedAt])
}

model ApplicationHistory {
  id            String   @id @default(cuid())
  applicationId String
  previousStage String
  newStage      String
  changedAt     DateTime @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model Interview {
  id            String   @id @default(cuid())
  applicationId String
  interviewer   String
  date          String // ISO date string yyyy-MM-dd
  time          String // HH:mm
  status        String   @default("Scheduled") // Scheduled | Completed | Cancelled
  feedback      String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([date])
}

// Admin-defined extra fields on the candidate profile (Settings > Candidate fields).
model CandidateField {
  id        String   @id @default(cuid())
  label     String
  labelCkb  String   @default("") // Kurdish Sorani label (optional)
  type      String   // text | number | file | select
  options   String   @default("[]") // JSON array of choices (select only)
  required  Boolean  @default(false)
  publicForm Boolean @default(true) // shown on the public application form
  sectionId String   @default("") // CandidateSection.id ("" = first section)
  showIf    String   @default("") // JSON {match:"all"|"any", conds:[{fieldId, op, value}]} (older: one {fieldId, op, value}) — empty = always shown
  settings  String   @default("{}") // JSON {ageFrom?: date field id, toLocation?: boolean, singleRow?: boolean}
  columnDefs String  @default("[]") // tables: JSON [{type, required, options}] — one per column (the names are in `options`)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CandidateSection {
  id        String   @id @default(cuid())
  name      String
  nameCkb   String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Organization {
  id         String   @id @default("org")
  name       String
  tagline    String   @default("")
  byline     String   @default("")
  company    String   @default("")
  website    String   @default("")
  websiteUrl String   @default("")
  footer     String   @default("")
  logo       String   @default("") // storage key of the uploaded logo ("" = built-in logo)
  logoVersion Int     @default(0)
  bannerName String   @default("") // footer banner: name
  version    String   @default("") // footer banner: version
  copyright  String   @default("") // footer banner: copyright text
  categoriesCleared Boolean @default(false) // the admin deleted the whole classification: don't re-add the starter data
  updatedAt  DateTime @updatedAt
}

model CandidateAccount {
  id           String   @id @default(cuid())
  username     String?  @unique // optional: the candidate can also sign in with the phone number
  passwordHash String
  code         String   @unique // unique candidate code, shown read-only on the application form
  fullName     String   @default("") // optional: pre-fills the application form
  email        String   @default("") // optional: pre-fills the application form
  phone        String?  // as typed (cleaned); required for new accounts
  phoneKey     String?  @unique // canonical phone digits: one access per phone number
  draft        String   @default("") // JSON: saved, not yet submitted application form
  draftAt      DateTime?
  candidateId  String?  @unique // set once the candidate has submitted the application
  submittedAt  DateTime?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model CvDesign {
  id          String   @id @default("cv")
  layout      String   @default("classic") // classic | modern | sidebar
  accent      String   @default("#0369a1")
  font        String   @default("sans") // sans | serif
  showCode    Boolean  @default(true)
  showLogo    Boolean  @default(true)
  hiddenSections String @default("[]") // JSON array of section ids to leave out of the CV
  headerNote  String   @default("")
  footerNote  String   @default("")
  updatedAt   DateTime @updatedAt
}
